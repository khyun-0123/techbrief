# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 GitHub에 올라가지 않는다.
# AI 서버는 두 곳(맥미니 / OpenRouter)이고 관리자 화면(/admin)에서 고른다. 값을 채운 곳만 고를 수 있다
# 처음 켤 때 쓸 곳 (local 또는 openrouter). 없으면 값이 채워진 첫 번째
# LLM_PROVIDER=local

# [맥미니] OpenAI 호환 주소 (Ollama)
LLM_BASE_URL=https://<맥미니 주소>/v1
LLM_API_KEY=
LLM_SUMMARY_MODEL=qwen3:14b
# Ollama의 Qwen3 생각 모드 끄기. 상용 API에서는 지운다
LLM_REASONING_EFFORT=none
# 맥미니(Ollama)일 때만: 한 번에 읽을 입력 크기(토큰). 없으면 Ollama 기본값(약 2,000)까지만 읽어 긴 보고서 입력이 잘림
# 상용 API를 쓸 때는 이 줄을 지운다
LLM_NUM_CTX=16384
# 보고서만 다른 모델로 쓰려면 (없으면 LLM_SUMMARY_MODEL)
# LLM_REPORT_MODEL=

# [OpenRouter] 키 발급: https://openrouter.ai/keys, 무료 모델은 ID 끝이 :free (목록: https://openrouter.ai/models)
# JSON 형식 지정(structured outputs)을 지원하는 모델을 고른다. 무료 모델은 분·일 요청 수 제한이 있다
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_REPORT_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 화면과 요약 API가 함께 쓰는 포트. 공용 서버에서는 계정에 배정된 PORT가 이미 있으면 적지 않는다
# PORT=3038

# 네이버 뉴스 검색 (NCP 콘솔 > NAVER API HUB > Application > 인증 정보의 Client ID / Client Secret)
# 계정 인증키(Access Key)가 아니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 관리자 화면(/admin) 비밀번호. 수집 키워드·회사·관심 기술·자동 최신화·AI 모델을 바꿀 수 있다 (17 문서)
# 없으면 관리자 기능이 잠겨 아무도 설정을 못 바꾼다. 예전 REFRESH_PASSWORD가 있으면 그 값을 대신 쓴다
# 관리자 아이디 (없으면 admin)
# ADMIN_ID=admin
ADMIN_PASSWORD=
# 로그인 대기(잠금) 리셋 조합: 로그인 칸에 이 아이디·비밀번호를 넣으면 대기만 풀리고 로그인은 안 된다 (19 문서)
# 외우기 쉬운 명령처럼 써도 된다 (예: timer / reset1!). 코드에는 적지 않는다. 둘 다 비우면 리셋 기능이 꺼진다
ADMIN_RESET_ID=
ADMIN_RESET_PASSWORD=

# 같은 이슈로 묶는 제목 유사도 기준 (기본 0.35, 낮출수록 더 많이 묶음)
# DEDUPE_SIMILARITY=0.35
# 중요도 점수의 경쟁사·관심 기업 (쉼표로 구분)
# COMPETITORS=삼성디스플레이,LG디스플레이,BOE

# PostgreSQL (수집 기사·요약·보고서 저장). 형식: postgresql://사용자:비밀번호@호스트:포트/DB이름
# 공용 서버에서는 팀별 DB를 받는다 (예: 사용자 team05, DB team05, 호스트 localhost, 포트 생략 시 5432)
# 비밀번호의 특수문자는 바꿔 적는다: @ → %40, # → %23, / → %2F. SSL이 필요하면 끝에 ?sslmode=require
DATABASE_URL=postgresql://team00:비밀번호@localhost:5432/team00
