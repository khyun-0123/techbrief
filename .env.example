# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 GitHub에 올라가지 않는다.
# AI 서버는 세 곳(맥미니 / OpenRouter / EXAONE API)이고 관리자 화면(/admin)에서 고른다. 값을 채운 곳만 고를 수 있다
# 처음 켤 때 쓸 곳 (local, openrouter, exaone 중 하나). 없으면 값이 채워진 첫 번째
# LLM_PROVIDER=local

# [맥미니] OpenAI 호환 주소 (Ollama)
LLM_BASE_URL=https://<맥미니 주소>/v1
LLM_API_KEY=
LLM_SUMMARY_MODEL=gemma4:12b
# Ollama의 Qwen3 생각 모드 끄기. 상용 API에서는 지운다
LLM_REASONING_EFFORT=none
# 대체 AI 서버 (local · openrouter · exaone 중 하나): 지금 서버가 연결 실패 · 시간 초과 · 5xx · 429면 사람이 누른 요청만 한 번 다시 보낸다.
# 자동 요약은 넘기지 않는다 (유료 비용). 비우면 꺼짐 (33 문서 6장 W19)
# LLM_FALLBACK=openrouter
# 맥미니(Ollama)일 때만: 한 번에 읽을 입력 크기(토큰). 없으면 Ollama 기본값(약 2,000)까지만 읽어 긴 보고서 입력이 잘림
# 상용 API를 쓸 때는 이 줄을 지운다
LLM_NUM_CTX=16384
# 보고서만 다른 모델로 쓰려면 (없으면 LLM_SUMMARY_MODEL)
# LLM_REPORT_MODEL=

# [OpenRouter] 키 발급: https://openrouter.ai/keys, 무료 모델은 ID 끝이 :free (목록: https://openrouter.ai/models)
# JSON 형식 지정(structured outputs)을 지원하는 모델을 고른다. 무료 모델은 분·일 요청 수 제한이 있다
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# OPENROUTER_REPORT_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# [EXAONE API] K-EXAONE 2.5 무료 API (https://docs.exaone.ai). OpenAI 호환, 키가 없으면 고를 수 없다
# 외부 서버 · 비상업 약관이라 공개 기사로 시험할 때만 쓴다 (23 문서 3-2)
# 키는 30일마다 만료된다. 401이 나면 새 키로 바꾸고 관리 페이지에서 「서버 다시 켜기」
EXAONE_API_KEY=
# 모델 (없으면 k-exaone_v2.5)
# EXAONE_MODEL=k-exaone_v2.5
# 보고서만 다른 모델로 쓰려면 (없으면 EXAONE_MODEL)
# EXAONE_REPORT_MODEL=
# 추론 강도. 추론은 끌 수 없고 기본값(max)은 느려서 low를 쓴다 (없으면 low)
# EXAONE_REASONING_EFFORT=low
# EXAONE_BASE_URL=https://api.exaone.ai/v1

# 화면과 요약 API가 함께 쓰는 포트. 공용 서버에서는 계정에 배정된 PORT가 이미 있으면 적지 않는다
# PORT=3038

# 네이버 뉴스 검색 (NCP 콘솔 > NAVER API HUB > Application > 인증 정보의 Client ID / Client Secret)
# 계정 인증키(Access Key)가 아니다
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 하루 호출 한도 (선택, 기본 없음). 11/13부터 월 한도(아래 *_MONTHLY_LIMIT)로 막는다. 하루로도 막고 싶을 때만 적는다
# 80%에서 자동 수집이, 98%에서 찾기가 멈춘다 (관리 페이지 「운영」 · 외부 출처 상태)
# NAVER_NEWS_DAILY_LIMIT=
# NAVER_DATALAB_DAILY_LIMIT=
# 네이버 API 주소를 바꿀 때만 (보통 비워 둔다)
# NAVER_NEWS_URL=https://naverapihub.apigw.ntruss.com/search/v1/news
# NAVER_TREND_URL=https://naverapihub.apigw.ntruss.com/search-trend/v1/search

# 네이버 검색광고 키워드 도구 (요즘 뜨는 기술의 연관 검색어 · 월 검색수, 일주일에 한 번, 25 문서)
# searchad.naver.com → 도구 → API 사용 관리. 위 뉴스 검색 키와 다르다. 셋 중 하나라도 비면 이 갈래만 건너뛴다
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_ACCESS_LICENSE=
NAVER_SEARCHAD_SECRET_KEY=
# 요즘 뜨는 기술 하루 갱신 끄기 (테스트 서버용). 비워 두면 켜짐
# TECH_TRENDS=off

# 관리자 화면(/admin) 비밀번호. 수집 키워드·회사·관심 기술·자동 최신화·AI 모델을 바꿀 수 있다 (17 문서)
# 없으면 관리자 기능이 잠겨 아무도 설정을 못 바꾼다. 예전 REFRESH_PASSWORD가 있으면 그 값을 대신 쓴다
# 관리자 아이디 (없으면 admin)
# ADMIN_ID=admin
ADMIN_PASSWORD=
# 로그인 대기(잠금) 리셋 조합: 로그인 칸에 이 아이디·비밀번호를 넣으면 대기만 풀리고 로그인은 안 된다 (19 문서)
# 외우기 쉬운 명령처럼 써도 된다 (예: timer / reset1!). 코드에는 적지 않는다. 둘 다 비우면 리셋 기능이 꺼진다
ADMIN_RESET_ID=
ADMIN_RESET_PASSWORD=

# 같은 이슈로 묶는 제목 유사도 기준 (기본 0.35, 낮출수록 더 많이 묶음)
# DEDUPE_SIMILARITY=0.35
# 중요도 점수의 경쟁사·관심 기업 (쉼표로 구분)
# COMPETITORS=삼성디스플레이,LG디스플레이,BOE
# 보고서 문장의 근거 기사 번호를 인정하는 글자 겹침 기준 (기본 0.35). 낮으면 "AI 보충 · 확인 필요"로 표시
# EVIDENCE_MIN_OVERLAP=0.35

# 특허 추이용 Google Cloud 서비스 계정 키 파일 (권한 600). 없으면 특허 그래프만 빠짐
# 프로젝트 폴더 밖에 둔다: 폴더 안에 두면 개발 서버가 주소(/gcp-key.json)로 그대로 내려 준다 (11/08 실제로 열렸음)
# GCP_KEY_FILE=/home/<계정>/.config/techbrief/gcp-key.json

# 전 세계 특허 제목 파일을 둘 폴더 (npm run patent-db가 만듦, 약 6GB, 11/12). 기본 ~/techbrief-data
# 프로젝트 폴더 밖에 둔다 (폴더 안이면 개발 서버가 그대로 내려 줄 수 있음). 없으면 디스플레이 밖 키워드 특허는 디스플레이 특허 안에서만 셈
# PATENT_TITLES_DIR=/home/<계정>/techbrief-data

# PostgreSQL (수집 기사·요약·보고서 저장). 형식: postgresql://사용자:비밀번호@호스트:포트/DB이름
# 공용 서버에서는 팀별 DB를 받는다 (예: 사용자 team05, DB team05, 호스트 localhost, 포트 생략 시 5432)
# 비밀번호의 특수문자는 바꿔 적는다: @ → %40, # → %23, / → %2F. SSL이 필요하면 끝에 ?sslmode=require
DATABASE_URL=postgresql://team00:비밀번호@localhost:5432/team00

# 논문 출처 (server/papers, 23 문서 2-7). 위에서부터 쓰고 막히면 다음 곳으로: OpenAlex → Crossref → Semantic Scholar → arXiv
# OpenAlex 무료 키 (하루 $1, 없으면 같은 IP 공용 $0.10): https://openalex.org/settings/api
# OPENALEX_API_KEY=
# Semantic Scholar 키 (없으면 공용 풀이라 거의 늘 429): https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=
# 팀 공용 연락처 (OpenAlex · Crossref 요청에 붙임). 개인 메일은 넣지 않는다. 비워 두면 안 붙임
# PAPER_CONTACT_EMAIL=

# 외부 출처 한도 (11/13, server/sourceGuard.js). 넘기 전에 자동 작업(80%) · 사람 요청(98%)을 멈춘다
# 네이버 API HUB 콘솔 기준 월 한도 (11/13 확인: 검색 월 7,750,000 · 검색어 트렌드 월 500,000). 하루 한도를 따로 두려면 *_DAILY_LIMIT
# NAVER_NEWS_MONTHLY_LIMIT=7750000
# NAVER_DATALAB_MONTHLY_LIMIT=500000
# BigQuery 이번 달 읽은 양 기준(GB). 무료 1TiB ≈ 1,100GB → 기본 1,050 (자동 작업은 85%, 사람 요청은 98%에서 멈춤)
# BIGQUERY_MONTHLY_GB=1050
